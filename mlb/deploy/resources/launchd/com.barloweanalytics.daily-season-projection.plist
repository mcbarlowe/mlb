<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.barloweanalytics.daily-season-projection</string>
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>__MLB_RUNNER_DIR__/run_daily_season_projection.sh</string>
    </array>
    <key>WorkingDirectory</key>
    <string>__MLB_STATE_ROOT__</string>
    <key>EnvironmentVariables</key>
    <dict>
        <key>BARLOWE_SEASON_PROJECTION_MAX_REFRESH_GAMES</key>
        <string>500</string>
        <key>BARLOWE_SEASON_PROJECTION_POST</key>
        <string>1</string>
        <key>BARLOWE_SEASON_PROJECTION_POST_PROVIDER</key>
        <string>bluesky</string>
        <key>BARLOWE_SEASON_PROJECTION_REFRESH_LOOKBACK_DAYS</key>
        <string>3</string>
        <key>BARLOWE_SEASON_PROJECTION_TRIALS</key>
        <string>5000</string>
        <key>BARLOWE_SEASON_PROJECTION_TUNE_TRIALS</key>
        <string>1000</string>
        <key>HOME</key>
        <string>__HOME__</string>
        <key>MLB_BIN_DIR</key>
        <string>__MLB_BIN_DIR__</string>
        <key>MLB_STATE_ROOT</key>
        <string>__MLB_STATE_ROOT__</string>
        <key>PATH</key>
        <string>__MLB_BIN_DIR__:/usr/local/bin:/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
        <key>PYTHONUNBUFFERED</key>
        <string>1</string>
        <key>UV_PYTHON_PREFERENCE</key>
        <string>managed</string>
    </dict>
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>8</integer>
        <key>Minute</key>
        <integer>30</integer>
    </dict>
    <key>RunAtLoad</key>
    <false/>
    <key>ProcessType</key>
    <string>Background</string>
    <key>StandardOutPath</key>
    <string>__MLB_LOG_DIR__/daily-season-projection.out.log</string>
    <key>StandardErrorPath</key>
    <string>__MLB_LOG_DIR__/daily-season-projection.err.log</string>
</dict>
</plist>
